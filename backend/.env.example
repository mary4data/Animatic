# Copy to .env and fill in. Never commit the real .env file.

# --- Gemini (Developer API) ---
# Used for: the ADK orchestrator's own reasoning, parse_script, generate_score,
# describe_character_reference, and generate_voice_lines (TTS). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults shown). gemini-flash-latest is a
# self-updating alias -- pinned versions (e.g. gemini-2.5-flash) can get
# deprecated out from under new API keys, which is why we don't hardcode one.
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Used for: generate_storyboard (one frame per scene). Also via the Developer
# API key above -- no separate Vertex AI project/credentials needed. If unset
# or the call fails, the tool falls back to a generated placeholder frame.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Vertex AI (Imagen 3) -- NOT currently used ---
# The original plan was Imagen 3 via Vertex AI; it returned 404 "not found or
# your project does not have access to it" (needs separate allowlisting this
# project didn't have), so generate_storyboard uses GEMINI_IMAGE_MODEL above
# instead. These are left here, unused, only in case you get real Imagen
# access and want to switch back -- see agent/clients.get_vertex_client().
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
IMAGEN_MODEL=imagen-3.0-generate-002

# --- Parallel Search API ---
# Used for: ground_visual_style. Get a key at https://platform.parallel.ai
PARALLEL_API_KEY=

# --- Service config ---
# Comma-separated list of frontend origins allowed to call this API.
# 8080 is this frontend's actual local dev port (Lovable's vite config
# pins it); 3000/5173 are included too in case that changes.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# Absolute base URL this service is reachable at, used to build media URLs
# returned to the frontend (e.g. https://pitch-bible-backend-xyz.a.run.app
# once deployed). Must not be localhost in a deployed environment.
PUBLIC_BASE_URL=http://localhost:8000
